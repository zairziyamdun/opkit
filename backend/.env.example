# PostgreSQL. Порт 5433 пробрасывается из docker-compose.yml
DATABASE_URL="postgresql://opkit:opkit_password@localhost:5433/opkit?schema=public"

# Секрет для подписи JWT access token
JWT_SECRET="change_me"

# Access token TTL в секундах (15 минут)
JWT_ACCESS_EXPIRES_SECONDS=900

# Refresh token TTL в днях (httpOnly cookie)
JWT_REFRESH_EXPIRES_DAYS=7

# Cookie: для localhost обычно lax + false.
# Если фронт и API на разных доменах (Vercel + Railway) — none + true
COOKIE_SAME_SITE="lax"
COOKIE_SECURE="false"

REDIS_URL="redis://localhost:6379"

PORT=3000
FRONTEND_URL="http://localhost:5173"
